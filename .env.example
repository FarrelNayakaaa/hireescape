# Server only. Supply an API key for live agent calls.
OPENAI_API_KEY=
# Strong model supplied by the organisers; used by Saboteur and Analyst.
OPENAI_MODEL=
# Optional faster model; falls back to OPENAI_MODEL.
OPENAI_MODEL_FAST=
# Optional gateway URL; leave blank to use the default OpenAI endpoint.
OPENAI_BASE_URL=
# Server only. Set a random secret of at least 32 characters for assessment tokens.
ASSESSMENT_SECRET=
# 1 = every agent returns fixtures; no API key is needed.
CODEX_MOCK=1
# 1 = enable demo entry points and fictional demo data.
NEXT_PUBLIC_DEMO_MODE=1
